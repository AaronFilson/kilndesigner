{
  "name": "@kilndesigner/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && tsc --noEmit -p e2e",
    "test": "vitest run",
    "coverage": "vitest run --coverage --coverage.include=src/** --coverage.exclude=src/main.tsx --coverage.exclude=src/**/*.test.*",
    "e2e": "playwright test -c e2e",
    "preview": "vite preview"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@kilndesigner/api-client": "^0.1.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.45",
    "@uiw/react-codemirror": "^4.25.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
