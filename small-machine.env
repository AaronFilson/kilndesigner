# Settings for a small or old machine, tuned on a 2015 13-inch MacBook Pro (2 cores, 4 threads,
# 16 GB, macOS 12 with Colima). Copy this file to .env and adjust it there: docker compose,
# scripts/colima.sh, and the API and worker run on the host all read .env.

# Docker's VM on a Mac (scripts/colima.sh start): its CPUs, its memory in GiB, and its priority
# from 0 (normal) to 20 (lowest). The VM keeps every page it has touched until it stops, so its
# memory is what macOS loses while it runs; 4 GiB leaves the Mac room for an editor and a browser.
# At a low priority the Mac comes first when both are busy, and the VM gets the rest. A priority
# can only be lowered while the VM runs; to raise it again, stop and start the VM.
KILNDESIGNER_VM_CPUS=2
KILNDESIGNER_VM_MEMORY=4
KILNDESIGNER_VM_NICE=10

# The worker (compose.yaml): how many builds it runs at once, and the CPUs and memory it may use.
# A build runs on about one CPU; the largest example peaked at 536 MB (measured 2026-10-26).
# The memory is enough for one build at a time: raise it with the number of builds.
KILNDESIGNER_WORKER_JOBS=1
KILNDESIGNER_WORKER_CPUS=1
KILNDESIGNER_WORKER_MEMORY=1536m
